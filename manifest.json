{
  "manifest_version": 3,
  "name": "ActiveDev",
  "version": "1.4.0",
  "description": "Never miss a GitHub review request across your repos and orgs. Review/CI status, daily notes, and optional focus nudges.",
  "permissions": [
    "identity",
    "alarms",
    "notifications",
    "storage",
    "idle"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ActiveDev",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "*://*/*"
  ]
}
