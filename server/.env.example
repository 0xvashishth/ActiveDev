# GitHub OAuth App credentials
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Public HTTPS URL of this server (for GitHub OAuth redirect)
PUBLIC_URL=https://your-project.vercel.app

# Local server port (default: 3000)
PORT=3000

# Optional: comma-separated Chrome extension IDs allowed to use this server.
# Leave empty to allow any extension (not recommended for production).
ALLOWED_EXTENSION_IDS=
