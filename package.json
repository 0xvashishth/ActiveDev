{
  "name": "active-dev-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend server for ActiveDev Chrome extension",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test 'tests/*.test.js'",
    "test:watch": "node --test --watch 'tests/*.test.js'",
    "test:coverage": "node scripts/check-coverage.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
